rules_version = '2';

// SmartScanner - Reglas de seguridad de Cloud Firestore
// Cada usuario autenticado solo puede leer y escribir SUS PROPIOS datos:
//   users/{uid}                  -> perfil y reglas de categorías
//   users/{uid}/inventory/{id}   -> artículos del inventario
// Todo lo demás está denegado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validItem(d) {
      return d.keys().hasOnly(['name', 'cat', 'qty', 'expiry', 'source', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.cat is string && d.cat.size() <= 40
        && d.qty is number && d.qty >= 0 && d.qty <= 1000000
        && d.expiry is string && d.expiry.size() <= 10
        && d.source is string && d.source.size() <= 60;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['email', 'displayName', 'categoryRules', 'updatedAt'])
        && (!('email' in d) || (d.email is string && d.email.size() <= 254))
        && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 120))
        && (!('categoryRules' in d) || (d.categoryRules is string && d.categoryRules.size() <= 5000));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if false;

      match /inventory/{itemId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validItem(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
